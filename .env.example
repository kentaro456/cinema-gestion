# Copier ce fichier en « .env » à la racine du projet puis adapter les valeurs.
# Le fichier .env n'est jamais versionné dans Git (voir .gitignore).
# Ne mettre ici AUCUNE vraie clé ni aucun mot de passe.

# Clé secrète Django : générer une valeur propre à chaque environnement.
DJANGO_SECRET_KEY=remplacer-par-une-longue-chaine-aleatoire

# true en développement, false en production
DJANGO_DEBUG=true

# Hôtes autorisés, séparés par des virgules
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Base de données : sqlite (par défaut) ou postgresql
DJANGO_DB_ENGINE=sqlite

# Utilisées seulement si DJANGO_DB_ENGINE=postgresql
POSTGRES_DB=cinema
POSTGRES_USER=cinema_user
POSTGRES_PASSWORD=remplacer-par-un-mot-de-passe-local
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
